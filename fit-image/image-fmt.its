/dts-v1/;

/ {
    description = "Aurel armhf kernel with dtb";

    images {
        kernel-0 {
            description = "Linux Kernel";
            data = /incbin/("%PATH%/zImage");
            type = "kernel";
            arch = "arm";
            os = "linux";
            compression = "none";
            load = <0x83000000>;
            entry = <0x83000000>;
            hash-1 {
                algo = "sha1";
            };            
        };
        fdt-0 {
            description = "Flattened Device Tree blob";
            data = /incbin/("%PATH%/imx6ull-var-dart-6ulcustomboard-nand-wifi-brcm.dtb");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
            hash-1 {
                algo = "sha1";
            };            
        };
    };
    configurations {
        default = "conf-0";
        conf-0 {
            description = "nand-wifi-brcm";
            kernel = "kernel-0";
            fdt = "fdt-0";
            hash-1 {
                algo = "sha1";
            };            
        };
    };
};
